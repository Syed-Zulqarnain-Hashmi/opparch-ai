# OPPARCH AI — Backend Environment Configuration Template
# Copy this file to .env and configure your secrets.

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./opparch_ai.db

# ── SECURITY ──────────────────────────────────────────────────────────────────
SECRET_KEY=opparch-ai-super-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LOCAL AI — OLLAMA (FREE, runs on your PC) ─────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=90
OLLAMA_CONNECT_TIMEOUT=3

# ── EMAIL OUTREACH & ZOHO SMTP ───────────────────────────────────────────────
SMTP_HOST=mail.zoho.com
SMTP_PORT=587
SMTP_USERNAME=contact@devarcher.com
SMTP_PASSWORD=
SMTP_FROM=contact@devarcher.com
SMTP_USE_TLS=true

IMAP_HOST=imap.zoho.com
IMAP_PORT=993

OUTREACH_DELAY_SECONDS=3
OUTREACH_BATCH_SIZE=10
