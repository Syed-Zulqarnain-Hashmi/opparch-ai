# ==============================================================================
# OPPARCH AI — Backend Production & Local Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your values.
# NEVER commit real API keys, passwords, or secrets to Git.
# ==============================================================================

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./opparch_ai.db
# Production PostgreSQL on Render / Neon / Supabase (uncomment and replace in Render):
# DATABASE_URL=postgresql+asyncpg://user:password@hostname.oregon-postgres.render.com/opparch_db

# ── APPLICATION & SERVER ──────────────────────────────────────────────────────
PORT=8000
DEMO_MODE=false

# ── SECURITY & AUTHENTICATION ─────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_64_char_hex_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ORIGINS ──────────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins (Vercel production and local dev)
CORS_ORIGINS=https://opparch-ai.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ── CLOUD AI PROVIDERS (OpenAI & Google Gemini) ───────────────────────────────
# Optional server-level keys (users can also provide keys in Settings)
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── LOCAL AI (Ollama - Optional on user PC) ───────────────────────────────────
# For local development: http://127.0.0.1:11434
# For cloud Render: Leave default or use a private secure tunnel
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=90
OLLAMA_CONNECT_TIMEOUT=3

# ── EMAIL OUTREACH & ZOHO SMTP INFRASTRUCTURE ─────────────────────────────────
# Zoho Mail configuration (contact@devarcher.com / mail.zoho.com:587 STARTTLS)
SMTP_HOST=mail.zoho.com
SMTP_PORT=587
SMTP_USERNAME=contact@devarcher.com
SMTP_PASSWORD=
SMTP_FROM=contact@devarcher.com
SMTP_USE_TLS=true

IMAP_HOST=imap.zoho.com
IMAP_PORT=993

OUTREACH_DELAY_SECONDS=3
OUTREACH_BATCH_SIZE=10
